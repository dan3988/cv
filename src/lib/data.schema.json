{
	"$schema": "https://json-schema.org/draft-07/schema#",
	"type": "object",
	"required": [
		"name",
		"email",
		"summary",
		"skills",
		"experience"
	],
	"properties": {
		"name": {
			"type": "string"
		},
		"profession": {
			"type": "string"
		},
		"website": {
			"type": "string"
		},
		"email": {
			"type": "string",
			"format": "email"
		},
		"location": {
			"type": "string"
		},
		"socials": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"href"
				],
				"properties": {
					"icon": {
						"type": "string"
					},
					"href": {
						"title": "string",
						"format": "url"
					},
					"title": {
						"title": "string"
					}
				}
			}
		},
		"summary": {
			"type": "string"
		},
		"skills": {
			"type": "object",
			"items": {
				"type": "array",
				"items": {
					"type": "string"
				}
			}
		},
		"experience": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"company",
					"role",
					"date",
					"skills"
				],
				"properties": {
					"company": {
						"type": "string"
					},
					"role": {
						"type": "string"
					},
					"date": {
						"type": "string"
					},
					"skills": {
						"type": "array",
						"items": {
							"type": "string"
						}
					}
				}
			}
		}
	}
}